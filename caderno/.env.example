# Preenchido automaticamente pela Vercel quando o banco Postgres é conectado ao projeto.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Necessário para o Aristides (seção 6). Criar em console.anthropic.com.
# Nunca preencher isso em .env.local versionado — só como variável de ambiente na Vercel.
ANTHROPIC_API_KEY=
