# Preenchido automaticamente pela Vercel quando o banco Postgres (Neon) é
# conectado ao projeto — o nome da variável pode vir como DATABASE_URL ou
# POSTGRES_URL dependendo de quando o banco foi criado; o app aceita as duas.
DATABASE_URL=
POSTGRES_URL=

# Necessário para o casamento de produto por IA. Mesma chave já usada pelo
# projeto Caderno (console.anthropic.com) — pode reaproveitar a mesma
# variável de ambiente na Vercel.
ANTHROPIC_API_KEY=
