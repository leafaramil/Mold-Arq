# Copie este arquivo para .env.local e preencha a chave.
#   cp .env.example .env.local

# Obrigatório para usar a IA. Sem ela, o app roda em modo demonstração
# (perguntas fixas e resumo sem interpretação).
ANTHROPIC_API_KEY=

# Opcionais — os valores abaixo são os padrões.
# ANTHROPIC_MODEL=claude-opus-5
# PORT=3000
# APP_TITLE=Briefing Arquitetônico
# BRIEFING_SCRIPT=corporativo-basico
# MAX_AI_TURNS=10
# OUTPUT_DIR=output
